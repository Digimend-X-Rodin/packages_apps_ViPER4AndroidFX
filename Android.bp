android_app_import {
    name: "ViPER4AndroidFX",
    owner: "ViperFX",
    apk: "system/priv-app/ViPER4AndroidFX/ViPER4AndroidFX.apk",
    privileged: true,
    preprocessed: true,
    presigned: true,
    dex_preopt: {
        enabled: false,
    },
    overrides: ["AudioFX", "MusicFX"],
    required: [
        "libv4a_aidl",
    ],
}

// ViPER4AndroidFX AIDL audio effect library (AIDL audio HAL, Android 15+).
// Exports createEffect/destroyEffect/queryEffect and registers the
// "viper.control" binder service consumed by ViPER4AndroidFX.
cc_prebuilt_library_shared {
    name: "libv4a_aidl",
    installable: true,
    strip: {
        none: true,
    },
    target: {
        android_arm: {
            srcs: ["vendor/lib/soundfx/libv4a_aidl.so"],
            shared_libs: [
                "libbase",
                "libbinder_ndk",
                "libcutils",
                "libfmq",
                "liblog",
                "libm",
                "libdl",
                "libc",
            ],
        },
        android_arm64: {
            srcs: ["vendor/lib64/soundfx/libv4a_aidl.so"],
            shared_libs: [
                "libbase",
                "libbinder_ndk",
                "libcutils",
                "libfmq",
                "liblog",
                "libm",
                "libdl",
                "libc",
            ],
        },
    },
    compile_multilib: "both",
    vendor: true,
    relative_install_path: "soundfx",
}
